{
  "name": "@shbernal/anki-apkg-export",
  "version": "6.1.1",
  "description": "Generate Anki deck packages from JavaScript and TypeScript.",
  "keywords": [
    "anki",
    "apkg",
    "deck-generation",
    "developer-tools",
    "flashcards",
    "spaced-repetition"
  ],
  "license": "MIT",
  "author": "shbernal <shbernal.01@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbernal/anki-apkg-export.git"
  },
  "files": [
    "CHANGELOG.md",
    "NOTICE",
    "dist"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -w -p tsconfig.build.json",
    "fixture:regen": "UPDATE_FIXTURE=1 vitest run test/deck-round-trip.test.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings",
    "oracle:check": "uv run tools/oracle/check_apkg.py",
    "oracle:collections": "uv run tools/oracle/gen_collections.py",
    "oracle:fixture": "uv run tools/oracle/gen_stripped_fields.py",
    "oracle:fixture:check": "uv run tools/oracle/gen_stripped_fields.py --check",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^5.0.3",
    "lefthook": "^2.1.17",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
