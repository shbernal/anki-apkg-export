{
  "name": "@shbernal/anki-apkg-export",
  "version": "5.1.0",
  "description": "Generate Anki deck packages from JavaScript and TypeScript.",
  "keywords": [
    "anki",
    "apkg",
    "deck-generation",
    "developer-tools",
    "flashcards",
    "spaced-repetition"
  ],
  "license": "MIT",
  "author": "shbernal <shbernal.01@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbernal/anki-apkg-export.git"
  },
  "files": [
    "CHANGELOG.md",
    "NOTICE",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -w -p tsconfig.build.json",
    "fixture:regen": "UPDATE_FIXTURE=1 vitest run test/deck-round-trip.test.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings",
    "oracle:check": "uv run tools/oracle/check_apkg.py",
    "oracle:fixture": "uv run tools/oracle/gen_stripped_fields.py",
    "oracle:fixture:check": "uv run tools/oracle/gen_stripped_fields.py --check",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^4.1.11",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}
