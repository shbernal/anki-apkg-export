{
  "name": "@shbernal/anki-apkg-export",
  "description": "Generate decks (.apkg) for Anki",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/sql.js": "^1.4.9",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.0.0",
    "prettier": "^3.7.4",
    "sqlite3": "^5.1.7",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "author": "shbernal <shbernal.01@gmail.com>",
  "keywords": [
    "anki",
    "spaced repetition software"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbernal/anki-apkg-export.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -w -p tsconfig.build.json",
    "lint": "eslint \"{src,test}/**/*.{ts,tsx}\"",
    "prepare": "pnpm run build",
    "test": "pnpm run lint && vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  }
}
