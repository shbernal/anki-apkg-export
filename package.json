{
  "name": "@shbernal/anki-apkg-export",
  "version": "6.1.0",
  "description": "Generate Anki deck packages from JavaScript and TypeScript.",
  "keywords": [
    "anki",
    "apkg",
    "deck-generation",
    "developer-tools",
    "flashcards",
    "spaced-repetition"
  ],
  "license": "MIT",
  "author": "shbernal <shbernal.01@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbernal/anki-apkg-export.git"
  },
  "files": [
    "CHANGELOG.md",
    "NOTICE",
    "dist"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -w -p tsconfig.build.json",
    "fixture:regen": "UPDATE_FIXTURE=1 vitest run test/deck-round-trip.test.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings",
    "oracle:check": "uv run tools/oracle/check_apkg.py",
    "oracle:collections": "uv run tools/oracle/gen_collections.py",
    "oracle:fixture": "uv run tools/oracle/gen_stripped_fields.py",
    "oracle:fixture:check": "uv run tools/oracle/gen_stripped_fields.py --check",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^5.0.0",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
