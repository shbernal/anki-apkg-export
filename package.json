{
  "name": "@shbernal/anki-apkg-export",
  "version": "6.2.0",
  "description": "Generate Anki deck packages from JavaScript and TypeScript.",
  "keywords": [
    "anki",
    "apkg",
    "deck-generation",
    "developer-tools",
    "flashcards",
    "spaced-repetition"
  ],
  "license": "MIT",
  "author": "shbernal <shbernal.01@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbernal/anki-apkg-export.git"
  },
  "files": [
    "CHANGELOG.md",
    "NOTICE",
    "dist"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -w -p tsconfig.build.json",
    "fixture:regen": "UPDATE_FIXTURE=1 vitest run test/deck-round-trip.test.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings",
    "oracle:check": "uv run tools/oracle/check_apkg.py",
    "oracle:collections": "uv run tools/oracle/gen_collections.py",
    "oracle:fixture": "uv run tools/oracle/gen_stripped_fields.py",
    "oracle:fixture:check": "uv run tools/oracle/gen_stripped_fields.py --check",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^5.1.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
